# ==============================================================================
# KADRO Production Environment Configuration (Railway / Cloud)
# ==============================================================================

APP_NAME=KADRO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PostgreSQL Database (الربط المباشر مع قاعدة بيانات ريل وي)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# ------------------------------------------------------------------------------
# Performance & High Traffic (الجلسات والكاش والطوابير)
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database

# ------------------------------------------------------------------------------
# Admin Account Protection (حساب المسؤول المعتمد - إلزامي لدخول لوحة الإدارة)
# ------------------------------------------------------------------------------
PLATFORM_ADMIN_USER_ID=1
PLATFORM_ADMIN_EMAIL=admin@kadro.local
PLATFORM_ADMIN_PASSWORD=AdminPassword123!

# ------------------------------------------------------------------------------
# Manga Catalog & Regional Policy (سياسة الكتالوج الإقليمية - إلزامي لعرض المانجا)
# ------------------------------------------------------------------------------
# WW تعني Worldwide، أو يمكن تحديد دولة مثل EG أو SA
MANGA_PUBLIC_TERRITORY=WW

# تفعيل المعالجة الخلفية للطوابير (Background Worker)
MANGA_ASYNC_CHAPTER_IMPORTS=true

# حدود معالجة ملفات PDF
MANGA_MAX_PDF_PAGES=60
MANGA_PDF_TIMEOUT=300
MANGA_PDFINFO_BIN=pdfinfo
MANGA_PDFTOPPM_BIN=pdftoppm

# ------------------------------------------------------------------------------
# Auto-Sync Popular Manga on Fresh Launch (جلب المحتوى العربي تلقائياً عند أول تشغيل)
# ------------------------------------------------------------------------------
AUTO_SYNC_INITIAL_MANGA=true

# ------------------------------------------------------------------------------
# Optional: Cloud Object Storage (S3 / Cloudflare R2 التخزين السحابي للصور)
# ------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=kadro-manga
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=false
